ORIGIN=http://localhost:3000
# Allow photo uploads up to ~6 MB .
BODY_SIZE_LIMIT=6M

# Email for sign-up verification codes 
# Leave SMTP_HOST unset in development and codes are printed in the `npm run dev` terminal instead.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=your-api-key-or-password
# EMAIL_FROM="Starboard <no-reply@yourdomain.com>"
